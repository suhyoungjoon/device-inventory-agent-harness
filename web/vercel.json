{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm ci",
  "rewrites": [
    {
      "source": "/domains",
      "destination": "https://inventory-harness-api.onrender.com/domains"
    },
    {
      "source": "/domains/:path*",
      "destination": "https://inventory-harness-api.onrender.com/domains/:path*"
    },
    {
      "source": "/runs",
      "destination": "https://inventory-harness-api.onrender.com/runs"
    },
    {
      "source": "/runs/:path*",
      "destination": "https://inventory-harness-api.onrender.com/runs/:path*"
    },
    {
      "source": "/harness",
      "destination": "https://inventory-harness-api.onrender.com/harness"
    },
    {
      "source": "/harness/:path*",
      "destination": "https://inventory-harness-api.onrender.com/harness/:path*"
    },
    {
      "source": "/compare",
      "destination": "https://inventory-harness-api.onrender.com/compare"
    },
    {
      "source": "/compare/:path*",
      "destination": "https://inventory-harness-api.onrender.com/compare/:path*"
    },
    {
      "source": "/analysis",
      "destination": "https://inventory-harness-api.onrender.com/analysis"
    },
    {
      "source": "/analysis/:path*",
      "destination": "https://inventory-harness-api.onrender.com/analysis/:path*"
    },
    {
      "source": "/proposals",
      "destination": "https://inventory-harness-api.onrender.com/proposals"
    },
    {
      "source": "/proposals/:path*",
      "destination": "https://inventory-harness-api.onrender.com/proposals/:path*"
    },
    {
      "source": "/history",
      "destination": "https://inventory-harness-api.onrender.com/history"
    },
    {
      "source": "/history/:path*",
      "destination": "https://inventory-harness-api.onrender.com/history/:path*"
    },
    {
      "source": "/memory",
      "destination": "https://inventory-harness-api.onrender.com/memory"
    },
    {
      "source": "/memory/:path*",
      "destination": "https://inventory-harness-api.onrender.com/memory/:path*"
    },
    {
      "source": "/constraints",
      "destination": "https://inventory-harness-api.onrender.com/constraints"
