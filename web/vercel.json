    {
      "source": "/params",
      "destination": "https://inventory-harness-api.onrender.com/params"
    },
    {
      "source": "/params/:path*",
      "destination": "https://inventory-harness-api.onrender.com/params/:path*"
    },
    {
      "source": "/demo",
      "destination": "https://inventory-harness-api.onrender.com/demo"
    },
    {
      "source": "/demo/:path*",
      "destination": "https://inventory-harness-api.onrender.com/demo/:path*"
    },
    {
      "source": "/workflow",
      "destination": "https://inventory-harness-api.onrender.com/workflow"
    },
    {
      "source": "/workflow/:path*",
      "destination": "https://inventory-harness-api.onrender.com/workflow/:path*"
    },
    {
      "source": "/agents",
      "destination": "https://inventory-harness-api.onrender.com/agents"
    },
    {
      "source": "/agents/:path*",
      "destination": "https://inventory-harness-api.onrender.com/agents/:path*"
