    },
    {
      "source": "/agent-tab/:path*",
      "destination": "https://inventory-harness-api.onrender.com/agent-tab/:path*"
    },
    {
      "source": "/llm",
      "destination": "https://inventory-harness-api.onrender.com/llm"
    },
    {
      "source": "/llm/:path*",
      "destination": "https://inventory-harness-api.onrender.com/llm/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ]
}
